<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <div class="w-full">
            <a class="bg-red-500 rounded-md px-3 py-2 text-sm mb-5 inline-block" href="/logout">Logout</a>
        </div>
        <h3 class="text-3xl">Hello, <%= user.name %> 😊</h3>
        <h5 class="mb-5">You can create new post.</h5>
        <form action="">
            <textarea placeholder="What's on your mind ?" class="block w-1/3 p-3 outline-none resize-none bg-transparent border-2 border-zinc-800 rounded-md" name="" id=""></textarea>
            <input class="px-3 py-2 w-40 text-sm bg-blue-500 block rounded-md mt-2" type="submit" value="Create New Post">
        </form>
    </div>
</body>
</html>